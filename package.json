{
  "name": "@quanzaiyu/agnes-media",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Agnes AI image and video generation for the Harness composer.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://cnb.cool/quanzaiyu/quanzaiyu/agnes-media.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agnes",
    "agnes-ai",
    "text-to-image",
    "text-to-video",
    "image-to-image",
    "image-to-video"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "market/index.json"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
